{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "origin-scientific-plotting": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/server/launch.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "ORIGIN_PRO_MCP_VISIBLE": "1",
        "ORIGIN_PRO_MCP_USE_DAEMON": "1",
        "ORIGIN_PRO_MCP_BACKEND": "originpro",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1",
        "ORIGIN_PRO_MCP_AUTOSAVE": "off",
        "ORIGIN_PRO_MCP_DIALOG_AUTODISMISS": "off"
      }
    }
  }
}
